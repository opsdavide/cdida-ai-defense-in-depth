# Security Configurations
JWT_SECRET=super_secret_dev_key_change_in_production
JWT_ALGORITHM=HS256
LOG_SIGNING_KEY=super_secret_log_signing_key_change_in_production

# Redis Rate Limiter Connection
REDIS_URL=redis://redis:6379/0

# Services Routing
AI_SERVER_URL=http://ai-application-server:5001

# Payload Inspector Thresholds
MAX_PROMPT_LENGTH=500
REPETITION_THRESHOLD=0.3
RISK_THRESHOLD=0.7
